# Copy to .env and fill in your Google Cloud credentials (never commit .env)
# Get them at: https://console.cloud.google.com/apis/credentials (Desktop OAuth Client ID)
VITE_GOOGLE_CLIENT_ID=
# REQUIRED in practice: even with PKCE, Google demands client_secret in the
# code -> token exchange for most Client IDs ("client_secret is missing" without it).
# It can come from .env (dev) or from Settings > Google in the app (localStorage).
VITE_GOOGLE_CLIENT_SECRET=
