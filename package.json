{
  "name": "google-tasks-desktop",
  "version": "1.0.0",
  "type": "module",
  "description": "Cliente desktop Windows para Google Tasks (API v1) com experiência Material Design 3",
  "main": "dist-electron/main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/celoalze/Celo-Google-Tasks.git"
  },
  "bugs": {
    "url": "https://github.com/celoalze/Celo-Google-Tasks/issues"
  },
  "homepage": "https://github.com/celoalze/Celo-Google-Tasks#readme",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "start": "electron .",
    "dist": "npm run build && electron-builder --win",
    "dist:portable": "npm run build && electron-builder --win portable",
    "dist:nsis": "npm run build && electron-builder --win nsis",
    "dist:dir": "npm run build && electron-builder --win --dir"
  },
  "keywords": [
    "google-tasks",
    "desktop",
    "electron",
    "react",
    "material-design-3",
    "todo"
  ],
  "author": "Celo Zaga",
  "license": "MIT",
  "engines": {
    "node": ">=20 <25"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.20",
    "electron": "^34.2.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^8.3.1",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  }
}
